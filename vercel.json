{
  "version": 2,
  "builds": [
    {
      "src": "ui/server.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "ui/**",
          "templates/**",
          "data/**",
          "images/**",
          "!images/3d/floating-island/source/**",
          "modes/**",
          "fonts/**",
          "config/monetization.yml",
          "portals.yml",
          "cv.md",
          "config/profile.yml"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "ui/server.mjs"
    },
    {
      "src": "/output/(.*)",
      "dest": "ui/server.mjs"
    },
    {
      "src": "/images/(.*)",
      "dest": "ui/server.mjs"
    },
    {
      "src": "/covers/(.*)",
      "dest": "ui/server.mjs"
    },
    {
      "src": "/(index.html|portfolio|portfolio.html)",
      "dest": "ui/server.mjs"
    },
    {
      "src": "/",
      "dest": "ui/server.mjs"
    },
    {
      "src": "/(.*\\.(jpg|png|woff2|pdf))",
      "dest": "ui/server.mjs"
    },
    {
      "src": "/(.*)",
      "dest": "ui/server.mjs"
    }
  ]
}
